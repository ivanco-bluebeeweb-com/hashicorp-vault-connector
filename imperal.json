{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "hashicorp-vault-connector",
  "version": "0.1.0",
  "name": "HashiCorp Vault",
  "description": "Connect your own HashiCorp Vault cluster (AppRole authentication) to read and manage KV v2 secrets, policies, and auth methods -- full read/write plus value-add vault health and secret-rotation reports. Secret values are never logged.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "vault:read",
    "vault:write"
  ],
  "tools": [
    {
      "name": "connect_vault",
      "description": "Connect your own HashiCorp Vault instance by saving its base URL plus an AppRole RoleID/SecretID, after checking it actually works.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "A friendly name for this Vault instance, e.g. 'Prod cluster'.",
            "title": "Label",
            "type": "string"
          },
          "base_url": {
            "description": "Your Vault instance's base URL, e.g. https://vault.yourcompany.com:8200",
            "title": "Base Url",
            "type": "string"
          },
          "role_id": {
            "description": "AppRole RoleID (vault read auth/approle/role/<name>/role-id).",
            "title": "Role Id",
            "type": "string"
          },
          "secret_id": {
            "description": "AppRole SecretID (vault write -f auth/approle/role/<name>/secret-id).",
            "title": "Secret Id",
            "type": "string"
          },
          "verify_ssl": {
            "default": true,
            "description": "Verify the Vault instance's TLS certificate. Turn off only for self-signed certs in trusted internal networks.",
            "title": "Verify Ssl",
            "type": "boolean"
          }
        },
        "required": [
          "base_url",
          "role_id",
          "secret_id"
        ],
        "title": "ConnectVaultParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "title": "Connection Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "title": "Label",
            "type": "string"
          }
        },
        "title": "ConnectVaultResult",
        "type": "object"
      },
      "event": "hashicorp-vault-connector.connect_vault",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_hashicorp-vault-connector_chat"
    },
    {
      "name": "disconnect_vault",
      "description": "Disconnect a HashiCorp Vault instance: deletes the saved RoleID/SecretID/token. Nothing in Vault itself is changed.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "delete:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "description": "The connection id to disconnect, from list_connections.",
            "title": "Connection Id",
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "DisconnectVaultParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "deleted": {
            "default": false,
            "title": "Deleted",
            "type": "boolean"
          },
          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          }
        },
        "title": "DeleteResult",
        "type": "object"
      },
      "event": "hashicorp-vault-connector.disconnect_vault",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_hashicorp-vault-connector_chat"
    },
