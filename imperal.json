          },
          "mount": {
            "default": "secret",
            "description": "The KV v2 secrets engine mount path, e.g. 'secret'.",
            "title": "Mount",
            "type": "string"
          },
          "path": {
            "default": "",
            "description": "Folder path to list within the mount, e.g. 'apps/'. Empty lists the root.",
